{
  "cleanUrls": true,
  "functions": {
    "api/admin/[action].js": { "maxDuration": 60, "includeFiles": "fonts/**" },
    "api/portal/[action].js": { "maxDuration": 60, "includeFiles": "fonts/**" },
    "api/cron/lulu-sync.js": { "maxDuration": 60 },
    "api/lulu-webhook.js": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/lulu-sync", "schedule": "5 * * * *" }],
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/my/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
