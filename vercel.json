{
  "cleanUrls": true,
  "functions": {
    "api/admin/[action].js": { "maxDuration": 60 },
    "api/portal/[action].js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/my/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
